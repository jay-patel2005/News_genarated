# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# Comma-separated list of hosts (no spaces) e.g. yourapp.onrender.com,your-domain.com
DJANGO_ALLOWED_HOSTS=*
# Comma-separated full origins starting with https:// e.g. https://yourapp.onrender.com,https://www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# APIs
NEWS_API_KEY=
OPENAI_API_KEY=
